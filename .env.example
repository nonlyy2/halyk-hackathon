# Copy to .env and set ONE key. The backend is chosen from whichever key is present, in the order
# anthropic -> openai -> gemini -> huggingface -> alibaba -> local ollama.
# Every provider is called over plain httpx: nothing to install, no SDK import that can fail.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# HF_TOKEN=hf_...
# ALIBABA_CLOUD_API_KEY=sk-...

# Pin the provider when several keys are present.
# COVENANT_BACKEND=anthropic      # anthropic | openai | gemini | huggingface | alibaba | ollama

# Which model serves each tier. "small" is per-document classification and per-transaction
# categorisation (~200 calls); "complex" is the covenant specs and term binding (~50 calls, and
# where model quality decides the score). Comma-separated names are fallbacks, tried in order as
# each one's quota runs out.
#
#   anthropic    small=claude-haiku-4-5-20251001   complex=claude-sonnet-5   (or claude-opus-5)
#   openai       small=gpt-4o-mini                 complex=gpt-4o
#   gemini       small=gemini-3.1-flash-lite       complex=gemini-3.1-flash-lite
#   alibaba      small=qwen3-8b                    complex=qwen3-max
#   ollama       small=qwen2.5:14b-instruct        complex=qwen2.5:14b-instruct
#
# Gemini free tier, measured: gemini-3.1-flash-lite allows 500 requests/day, every other usable
# model allows 20 -- too few to carry one stage. Every *-pro model reports limit 0.
# COVENANT_MODEL_SMALL=claude-haiku-4-5-20251001
# COVENANT_MODEL_COMPLEX=claude-sonnet-5

# Point the selected backend at a different OpenAI-compatible host (gateway, proxy, self-hosted).
# COVENANT_BASE_URL=https://your-gateway.example.com/v1
# ALIBABA_BASE_URL=https://<workspace>.<region>.maas.aliyuncs.com/compatible-mode/v1

# Documents and scenarios worked on at once.
COVENANT_CONCURRENCY=4
# Minimum seconds between requests, shared across all of them. 0 on a paid endpoint.
COVENANT_MIN_INTERVAL=0
# Seconds before a model whose daily quota refused is probed again.
# COVENANT_EXHAUSTED_RETRY=600

# After setting a key: `covenant ping` makes one call per tier and reports model and latency.
